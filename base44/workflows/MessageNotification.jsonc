{
  "description": "Cr\u00e9e une notification in-app \u00e0 chaque cr\u00e9ation, mise \u00e0 jour ou suppression d'un message.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "message_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createNotification",
            "args": {
              "kind": "message",
              "event_type": "${ .trigger.event_type }",
              "data": "${ .trigger.data }",
              "old_data": "${ .trigger.old_data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Cr\u00e9er la notification",
            "description": "Message re\u00e7u / modifi\u00e9 / supprim\u00e9"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "Message"
    }
  },
  "name": "Notification de message"
}