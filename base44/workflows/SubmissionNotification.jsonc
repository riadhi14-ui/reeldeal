{
  "description": "Cr\u00e9e une notification in-app pour la marque \u00e0 chaque nouvelle soumission vid\u00e9o.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "submission_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createNotification",
            "args": {
              "kind": "submission",
              "event_type": "${ .trigger.event_type }",
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Cr\u00e9er la notification",
            "description": "Nouvelle vid\u00e9o soumise"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Submission"
    }
  },
  "name": "Notification de soumission"
}