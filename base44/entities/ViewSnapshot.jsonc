{
  "name": "ViewSnapshot",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "views": {
      "type": "number"
    },
    "previous_views": {
      "type": "number"
    },
    "delta": {
      "type": "number"
    }
  },
  "required": [
    "submission_id",
    "creator_id",
    "brand_id",
    "views",
    "previous_views",
    "delta"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "data.brand_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}